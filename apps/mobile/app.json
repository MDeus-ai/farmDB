{
  "expo": {
    "name": "farmDB",
    "slug": "farmdb",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a580457d-475d-463e-b3fb-7faaf8b8964b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeusdoreens.farmdb"
    },
    "android": {
      "package": "com.zeus_doreens.farmdb",
      "adaptiveIcon": {
        "backgroundColor": "#e6f2ec",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow farmDB to use the camera to photograph livestock for local offline records.",
          "photosPermission": "Allow farmDB to select livestock photos from your photo library."
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a580457d-475d-463e-b3fb-7faaf8b8964b"
      }
    }
  }
}
