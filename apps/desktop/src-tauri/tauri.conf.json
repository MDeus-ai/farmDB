{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "farmDB",
  "version": "1.5.2",
  "identifier": "com.farmdb.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "farmDB",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQkY2NDNCRjg0QjA3RkIKUldUN0IwdjRPMlMvR3dOa1pTeEFxRm1KK25hL0JTamlvN3BoWHVZNTFYNlVObm1FNHllNDlLYzEK",
      "endpoints": [
        "https://github.com/MDeus-ai/farmDB/releases/latest/download/latest.json"
      ]
    }
  }
}